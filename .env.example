# ============================================================
# 内部需求协作平台 - 环境变量样例
# 使用方式：cp .env.example .env 后按实际环境修改
# ============================================================

# ---------- 通用 ----------
# 生产保持 production；本地开发快捷登录需要显式改为 development
NODE_ENV=development
# 平台对外域名（不带协议）；生产环境填写真实域名，Caddy 会自动启用 HTTPS
APP_DOMAIN=app.localhost
# Caddy 站点地址（多个地址用「逗号 + 空格」分隔）
#   生产环境：app.example.com（同时承载平台与 Git 服务，见下方说明）
#   本地调试：http://localhost（平台，映射到宿主机 8080）+ http://localhost:8081（Git 服务）
# 注意：免密登录（SSO）依赖浏览器 Cookie，而 Cookie 只按「主机名」区分、不区分端口，
#      因此平台与 Git 服务必须使用同一主机名（本地统一用 localhost，局域网用服务器 IP）。
#      不要写成 app.localhost + git.localhost 这种「主机名不同」的组合，否则点进 Git 服务会退回登录页。
APP_ADDR=http://localhost
GITEA_ADDR=http://localhost:8081
# Caddy 映射到宿主机的端口；若 80/443 已被占用（已有 Nginx 等）可改为 8080/8443
CADDY_HTTP_PORT=8080
CADDY_HTTPS_PORT=8443
# 平台对外访问地址（自研需求协作平台），主机名需与 APP_ADDR 一致
APP_URL=http://localhost:8080
# 平台后端 API 对外地址
API_URL=http://localhost:8080/api
# 容器内部后端地址（供前端服务端渲染与容器内调用）
API_INTERNAL_URL=http://api:4000
# ACME 证书通知邮箱（使用真实域名时填写）
ACME_EMAIL=admin@aimanager.com
# 时区
TZ=Asia/Shanghai

# ---------- PostgreSQL（Gitea 与平台共用实例，分库） ----------
POSTGRES_USER=aimanager
POSTGRES_PASSWORD=change-me-postgres-password
POSTGRES_DB=aimanager
# Gitea 独立数据库名（由 init-databases.sh 自动创建）
GITEA_DB_NAME=gitea

# ---------- Redis（异步任务队列） ----------
REDIS_PASSWORD=change-me-redis-password

# ---------- Gitea ----------
# Gitea 对外域名（不带协议），用于生成仓库地址；需与 APP_URL 的主机名一致（SSO 要求）
GITEA_DOMAIN=localhost
# Gitea 对外根地址（带协议，末尾斜杠）；端口即 GITEA_ADDR 中的端口
GITEA_ROOT_URL=http://localhost:8081/
# Gitea SSH 对外端口
GITEA_SSH_PORT=2222
# Gitea 管理员账号（由 deploy/gitea/init.sh 创建）
# 平台初始管理员会自动绑定该账号，因此「代码仓库」按钮点开就是管理员身份，无需再注册
GITEA_ADMIN_USER=gitea-admin
GITEA_ADMIN_PASSWORD=change-me-gitea-admin
GITEA_ADMIN_EMAIL=admin@aimanager.com
# Gitea 组织名：所有平台创建的项目仓库都放在该组织下
GITEA_ORG=projects
# 由 deploy/gitea/init.sh 自动写入的 API Token（拥有仓库/组织/Issue 写权限）
GITEA_API_TOKEN=
# Webhook 签名密钥：平台回调校验用
GITEA_WEBHOOK_SECRET=change-me-webhook-secret
# 流水线状态回调令牌（留空则复用 GITEA_WEBHOOK_SECRET）
CI_CALLBACK_TOKEN=
# 远程 Streamable HTTP MCP 端口（由 Caddy 的 /mcp 路由转发）
AIM_MCP_PORT=4100

# ---------- 后端认证 ----------
JWT_SECRET=change-me-jwt-secret-at-least-32-characters
JWT_EXPIRES_IN=7d
# 开发账号选择器：仅 development 环境显示；选择后填充账号密码，再走普通登录
DEV_USER_PICKER_ENABLED=false
# 选择器填充的开发密码，需与演示数据种子或对应账号密码保持一致
DEV_PICKER_ADMIN_PASSWORD=Admin@123456
DEV_PICKER_USER_PASSWORD=Demo@123456

# ---------- 需求图片与附件上传 ----------
# 存储目录：容器内路径，由 docker volume（uploads-data）持久化
UPLOAD_DIR=/app/uploads
# 单个图片或附件大小上限（MB），格式不做白名单限制
UPLOAD_MAX_MB=100
# 自定义头像大小上限（MB），头像接口只接受图片
AVATAR_MAX_MB=5

# ---------- 初始管理员账号（首次启动且平台无管理员时自动创建） ----------
ADMIN_EMAIL=admin@aimanager.com
ADMIN_PASSWORD=Admin@123456
ADMIN_NAME=平台管理员

# ---------- 邮件通知（可选，留空则只写日志） ----------
MAIL_ENABLED=false
MAIL_HOST=smtp.example.com
MAIL_PORT=465
MAIL_SECURE=true
MAIL_USER=notify@example.com
MAIL_PASSWORD=
MAIL_FROM="需求协作平台 <notify@example.com>"
